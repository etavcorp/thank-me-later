{
  "name": "thank-me-later-worker",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thank-me-later-db-local",
      "database_id": "local"
    }
  ],

  // Environment-specific configurations
  "env": {
    "uat": {
      "name": "thank-me-later-worker-uat",
      "vars": {
        "APP_ENV": "uat",
        "ALLOWED_ORIGINS": "https://uat.thankmelatercatering.com,https://www.uat.thankmelatercatering.com,https://thank-me-later-worker-uat.etavcorp.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "thank-me-later-db-uat",
          "database_id": "21ac1c5d-d903-4ee6-9b99-e0d35021c0ce"
        }
      ]
    },
    "prd": {
      "name": "thank-me-later-worker-prd",
      "vars": {
        "APP_ENV": "prd",
        "ALLOWED_ORIGINS": "https://thankmelatercatering.com,https://www.thankmelatercatering.com,https://uat.thankmelatercatering.com,https://thank-me-later-worker-prd.etavcorp.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "thank-me-later-db-prd",
          "database_id": "5f67cdc8-1965-4910-b61e-52a4c976f110"
        }
      ]
    }
  }
}